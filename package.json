    "preview": "astro preview",
    "check": "npm i --no-save @astrojs/check typescript && astro check",
    "check:fr": "node tools/check-french.cjs",
    "check:llms": "node tools/check-llms.cjs",
    "check:docs": "node tools/check-docs.cjs",
    "check:privacy": "node tools/check-privacy.cjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/vercel": "^11.0.10",
    "astro": "^7.3.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "axe-core": "^4.13.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "path-to-regexp": "^6.3.0"
  }
