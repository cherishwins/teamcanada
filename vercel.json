{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/og/([a-z0-9-]+\\.[0-9a-f]+)\\.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/marks/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/api/record.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(llms-full|llms|ai|humans|LICENSE)\\.txt",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://cloud.umami.is 'sha256-ipVu24fJB4N9VK6cLL0TmioKXqjvYwd6zJ/Sn+5suLg=' 'sha256-NZN8NwqHdhlambRlxo4ziGwfKQzdXBx5Psu2yNs225Y=' 'sha256-6FsAfYV+MJF6lAEYyoACyH0na3wmpxmAWJdRXWFp0fY=' 'sha256-8Y7CR8M/2Dh8NUyQaYjqw7xtMIg0aXhgqrhJE/nrXwM=' 'sha256-DZe0PnD+Kr6WPINxjP2/gbCIfdut1AMFt7a4xa6yERQ=' 'sha256-586yXTmhnO44z+Udqb4IsgIeV6vA1tPDet221DLJqzA=' 'sha256-iOSIhEponbBmOEkDjGaF19OtHLRBafTskHtWp69wd9Q=' 'sha256-OtAOWinLMlIuCObB9+FkNE0KrAgp5EGPsgLkAzBagLc='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloud.umami.is https://gateway.umami.is; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
        { "key": "Link", "value": "<https://creativecommons.org/publicdomain/zero/1.0/>; rel=\"license\"" }
      ]
    }
  ],
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "teamcanada\\.vercel\\.app" }], "destination": "https://northerntemper.ca/$1", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/(.*)/index\\.html", "destination": "/$1", "permanent": true },
    { "source": "/(.*)\\.html", "destination": "/$1", "permanent": true },
    { "source": "/go/poilievre", "destination": "https://www.linkedin.com/posts/jessecares_pierre-poilievre-and-everyones-mother-wants-activity-7467130700870348800-mtOI", "permanent": false },
    { "source": "/go/swf", "destination": "https://www.linkedin.com/posts/jessecares_canadas-sovereign-wealth-fund-ugcPost-7468997068183740416-5w1B", "permanent": false },
    { "source": "/go/enough", "destination": "https://www.linkedin.com/posts/jessecares_enough-is-enough-activity-7453025502757408768-y6QT", "permanent": false },
    { "source": "/go/eyes", "destination": "https://www.linkedin.com/posts/jessecares_%F0%93%81%B9-%F0%93%81%B9-activity-7423256275251118080-RR0S", "permanent": false },
    { "source": "/go/resume", "destination": "https://www.linkedin.com/posts/jessecares_activity-7426631285034409984-DGb8", "permanent": false },
    { "source": "/go/shrug", "destination": "https://www.linkedin.com/posts/jessecares_%E3%83%84-activity-7426506091624198144-OcFR", "permanent": false }
  ]
}
