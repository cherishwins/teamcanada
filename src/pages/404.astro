---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BearHead from '../components/marks/BearHead.astro';
---
<Base title="Lost the trail" description="That page is not here." path="/404" noindex>
  <Nav />
  <main id="main">
    <section class="lost">
      <div class="nt-wrap">
        <BearHead alt="" class="mk" />
        <div class="nt-label" style="margin-top:var(--space-4);">Four · Zero · Four</div>
        <hr class="nt-rule" />
        <h1 class="nt-display md">Lost the trail.</h1>
        <p style="color:var(--text-muted);margin-top:var(--space-3);max-width:44ch;">
          That page is not here. Nothing has been taken down — the site was
          rebuilt, and some older addresses moved. An old address ending in
          .html now forwards to its page by itself.
        </p>
        <ul class="links">
          <li><a href="/">I · Temper, the beginning</a></li>
          <li><a href="/hand">II · The Hand</a></li>
          <li><a href="/math">III · The Math</a></li>
          <li><a href="/bloc">IV · The Bloc</a></li>
          <li><a href="/build">V · The Build</a></li>
          <li><a href="/record">The record</a></li>
          <li><a href="/read">The reads</a></li>
          <li><a href="/sources">Every figure, and where it came from</a></li>
        </ul>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
<style>
  .lost { padding-block: clamp(60px, 12vh, 160px); }
  /* :global because the class lands on BearHead's own <svg>, which this page's
     scoped styles never reach: unscoped, the mark filled the column, about
     1,000px tall at 1440, and pushed the message below the fold. */
  .lost :global(.mk) { width: clamp(80px, 14vw, 150px); height: auto; color: var(--nt-red); }
  .links { list-style: none; margin: clamp(26px, 4vh, 46px) 0 0; padding: 0; }
  .links li { border-top: var(--border-hair) solid var(--border-hairline); }
  .links li:last-child { border-bottom: var(--border-hair) solid var(--border-hairline); }
  .links a {
    display: block; padding: 15px 0; text-decoration: none;
    font-family: var(--font-display); font-weight: var(--fw-label);
    font-size: var(--type-label); letter-spacing: var(--ls-key);
    text-transform: uppercase; color: var(--nt-n-420);
    transition: color .2s var(--ease), padding-inline-start .2s var(--ease);
  }
  .links a:hover { color: var(--nt-white); padding-inline-start: 10px; }
</style>
