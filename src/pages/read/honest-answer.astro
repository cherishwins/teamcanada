<Read
  title={"One Question. Seven Leaders. An Honest Answer."}
  description={"The viral G7 recession quiz, answered with every official GDP figure from all seven statistics offices."}
  imprint={"The record, set straight"}
  standfirst={"The viral \"who is in recession\" quiz, answered with every official G7 GDP figure. The trick is in the question."}
