<Read
  title={"The Wave Hit Every G7 Democracy. Two Leaders Beat It."}
  pageTitle={"Two Leaders Beat the Wave"}
  description={"Anti-incumbent anger flattened the West. Japan and Canada are the exceptions \u2014 and the reason is a method, not a party."}
  imprint={"A governance reading"}
  standfirst={"Anti-incumbent anger flattened the West. Two leaders are the exceptions, and the reason is a method anyone can copy."}
