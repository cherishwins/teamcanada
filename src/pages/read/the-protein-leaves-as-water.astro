    font-family: var(--font-display); font-weight: var(--fw-label); font-size: var(--type-label-sm); letter-spacing: var(--ls-key); text-transform: uppercase; cursor: pointer;
  }
  .reset:hover { background: var(--nt-black); color: var(--nt-white); border-color: var(--nt-black); }
  .facts.three { grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); }
  .facts dt[data-out] { font-size: clamp(28px, 3.8vw, 44px); }
  /* The landed-price bar: the price in the chart colour, the surtax on top of it in red, our price as a black mark. */
  .lbar { position: relative; height: 28px; margin: var(--space-3) 0 var(--space-1); background: var(--nt-n-260); display: flex; }
  .lbar .seg { display: block; height: 100%; transition: width .25s var(--ease); }
  .lbar .base { background: var(--data-primary); }
  .lbar .surtax { background: var(--data-strike); }
  .lbar .ours { position: absolute; top: -6px; bottom: -6px; width: 3px; margin-left: -1px; background: var(--nt-black); transition: left .25s var(--ease); }
  /* The run panel's three bars on one scale. */
  .stack { margin: var(--space-3) 0 0; }
  .stack .row { margin-bottom: var(--space-2); }
  .stack .lab { margin: 0 0 4px; font-family: var(--font-display); font-weight: var(--fw-label); font-size: var(--type-label-sm); letter-spacing: var(--ls-key); text-transform: uppercase; }
  .stack .lab span { color: var(--nt-red); margin-left: .5em; font-variant-numeric: tabular-nums; }
  .stack .bar { display: flex; gap: 2px; height: 20px; background: var(--nt-n-260); }
  .stack .seg { display: block; height: 100%; transition: width .25s var(--ease); }
  .stack .seg.in { background: var(--data-primary); }
  .stack .seg.cream { background: var(--nt-n-460); }
  .stack .seg.cost { background: var(--data-inert); }
  .stack .seg.strike { background: var(--data-strike); }
  .stack .key { margin: 4px 0 0; font-size: var(--type-body-sm); color: var(--text-muted); }
  .stack .key span { font-variant-numeric: tabular-nums; color: var(--text-body); }
  @media (prefers-reduced-motion: reduce) { .lbar .seg, .lbar .ours, .stack .seg { transition: none; } }
  @media (forced-colors: active) {
    .lbar .base, .lbar .surtax, .stack .seg { background: CanvasText; } .lbar .surtax, .stack .seg.strike { background: Highlight; }
  }

  .mark { margin: clamp(30px, 4.5vh, 56px) auto var(--space-3); max-width: 22rem; color: var(--nt-black); }
  .mark :global(svg) { width: 100%; height: auto; display: block; }

  .pull {
    margin: clamp(30px, 4.5vh, 56px) 0; padding-left: clamp(18px, 2.4vw, 30px);
    border-left: var(--rule-weight) solid var(--nt-red);
    font-family: var(--font-display); font-weight: var(--fw-display);
    text-transform: uppercase; line-height: 1.1; font-size: clamp(20px, 2.8vw, 34px);
  }
  .sign {
    font-family: var(--font-display); font-weight: var(--fw-display);
    text-transform: uppercase; letter-spacing: .06em;
    font-size: clamp(22px, 2.6vw, 32px); margin: var(--space-3) 0 var(--space-1);
  }
  .notes cite { font-style: normal; font-weight: var(--fw-body-strong); }
  .notes a { overflow-wrap: anywhere; }
</style>

<script>
  // The two panels. Every figure they print comes from src/lib/whey.ts, the
  // module the page ran at build, so the browser cannot disagree with the
  // ledger above it. The surtax rate and the bar's scale ride on the form as
  // data attributes, rendered from figures.ts and the model, never typed here.
  import { run, landed, dollars, kg } from '../../lib/whey';

  const outs = (root: Element) => {
    const map = new Map<string, HTMLElement>();
    root.querySelectorAll<HTMLElement>('[data-out]').forEach((el) => map.set(el.dataset.out!, el));
    return (k: string, v: string) => { const el = map.get(k); if (el) el.textContent = v; };
  };
  const seg = (root: Element, k: string, pctOf: number) => {
    const el = root.querySelector<HTMLElement>(`[data-seg="${k}"]`);
    if (el) el.style.width = `${Math.max(0, pctOf).toFixed(2)}%`;
  };
  const field = (group: Element, name: string) => group.querySelector<HTMLInputElement>(`[name="${name}"]`)!;
  const num = (group: Element, name: string) => Number(field(group, name).value);
  const echo = (group: Element, k: string, v: string) => { const el = group.querySelector<HTMLElement>(`[data-echo="${k}"]`); if (el) el.textContent = v; };
  const months = (v: number) => (Number.isFinite(v) && v > 0 ? `${v.toFixed(1)} months` : 'never');
  // The inputs' default values are the base case, rendered at build; "back to
  // the base case" puts each one back to its own attribute.
  const wire = (group: Element, render: () => void) => {
    group.addEventListener('input', render);
    group.querySelector('[data-reset]')?.addEventListener('click', () => {
      group.querySelectorAll<HTMLInputElement>('input').forEach((i) => { if (i.type === 'checkbox') i.checked = i.defaultChecked; else i.value = i.defaultValue; });
      render();
    });
    render();
  };

  const land = document.querySelector<HTMLElement>('[data-land]');
  const landRoot = land?.closest('.panel');
  if (land && landRoot) {
    const set = outs(landRoot);
    const rate = Number(land.dataset.surtax), max = Number(land.dataset.max), ours = Number(land.dataset.ours);
    wire(land, () => {
      const usd = num(land, 'usd'), fx = num(land, 'fx');
      const on = field(land, 'surtax').checked;
      const l = landed(usd, fx, on ? rate : 0);
      echo(land, 'usd', `US$${usd.toFixed(2)}`);
      echo(land, 'fx', `$${fx.toFixed(2)}`);
      seg(landRoot, 'base', (l.cadPerKg / max) * 100);
      seg(landRoot, 'surtax', (l.surtaxPerKg / max) * 100);
      set('landed', `$${l.withSurtax.toFixed(2)}`);
      set('surtax', `$${l.surtaxPerKg.toFixed(2)}`);
      set('ours', `${((ours / l.withSurtax) * 100).toFixed(0)}%`);
    });
  }

  const form = document.querySelector<HTMLElement>('[data-run]');
  const root = form?.closest('.panel');
  if (form && root) {
    const set = outs(root);
    wire(form, () => {
      const r = run({
        litresPerDay: num(form, 'litresPerDay'), pricePerKg: num(form, 'pricePerKg'), yieldShare: num(form, 'yieldShare'),
        grantShare: num(form, 'grantShare'), tollPerKg: num(form, 'tollPerKg'),
      });
      const y = r.y, rev = y.revenue;
      echo(form, 'litres', `${r.m.litresPerDay.toLocaleString('en-CA')} L`);
      echo(form, 'price', `$${r.m.pricePerKg.toFixed(2)}`);
      echo(form, 'yield', `${kg(r.m.basePowderKgDay)} of ${kg(r.d.maxPowderKg)}`);
      echo(form, 'grant', `${Math.round(r.m.grantShare * 100)}%, ${dollars(r.grant)}`);
      echo(form, 'toll', `$${r.m.tollPerKg.toFixed(2)}`);
      set('ebitda', dollars(y.ebitda));
      set('payback', months(y.paybackMonths));
      set('net', dollars(r.net));
      set('cents', `${Math.max(0, r.p.centsPerLitre).toFixed(1)}¢`);
      set('plant', dollars(Math.max(0, r.p.share)));
      set('powder', kg(r.m.basePowderKgDay));
      set('tonnes', String(Math.round(y.powderKg / 1000)));
      set('revenue', dollars(rev)); set('powderRevenue', dollars(y.powderRevenue)); set('cream', dollars(y.cream));
      set('opex', dollars(y.opex)); set('toll', dollars(y.toll)); set('left', dollars(y.left));
      seg(root, 'powder', (y.powderRevenue / rev) * 100); seg(root, 'cream', (y.cream / rev) * 100);
      for (const k of ['toll', 'freight', 'labour', 'power', 'membranes', 'licence'] as const) seg(root, k, (y[k] / rev) * 100);
      seg(root, 'left', (y.left / rev) * 100);
    });
  }
</script>
