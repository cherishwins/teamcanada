        { label: 'New Brunswick', values: [3070] },
        { label: 'Quebec', values: [1560] },
        { label: 'Newfoundland and Labrador', values: [210] },
        { label: 'Ontario', values: [38] },
        { label: 'Alberta', values: [0] },
        { label: 'British Columbia', values: [0] },
