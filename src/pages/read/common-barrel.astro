import Read from '../../layouts/Read.astro';
import Share from '../../components/Share.astro';
import BarTable from '../../components/BarTable.astro';
import BearDual from '../../components/marks/BearDual.astro';

/**
 * Northern Temper Paper No. 03, the web edition of the owner's own page
 * "Common Barrel" (Jesse James, October 2026), uploaded 17 October 2026.
 * The words are the author's. Facts were checked against the paper's own
 * sources before it was published here, and four things changed:
 *   - "More than 90 per cent of oil sands exports go to the United States"
 *     is now "nearly nine barrels in ten of the crude Canada exports": the
 *     Canada Energy Regulator and EIA data CAPP summarised in April 2026 put
 *     the US share of Canadian crude exports at 87 percent in 2025, down
 *     from 95 in 2023, since the Trans Mountain expansion opened Asia. The
 *     CTV story the author cited stays as note 1; CAPP is added beside it.
 *   - Note 9, Federated Co-operatives' "The story of the Co-op Refinery
 *     Complex", answers 200 with a "Page Not Found" body: the page is gone.
 *     The 1933 tariff of 3.7 cents a gallon and the eight farmers are now
 *     cited to the CCRL Refinery Complex article on Wikipedia, which the
 *     paper already uses for notes 12 and 22, and which states both.
 *   - Note 25, a CTV Edmonton story on the Heritage Fund, redirects to a
 *     404. The 1976 founding, Lougheed and the 30 percent deposit rule are
 *     now cited to the fund's Wikipedia article and to alberta.ca.
 *   - The Sturgeon figures hold: $5.7 billion when sanctioned in November
 *     2012 (Oil & Gas Journal, 2013), $10.1 billion by 2020 (CBC), and
 *     about 78,000 barrels a day of diluted bitumen per the partnership's
 *     own 2015 statement, which is 50,000 of bitumen plus diluent.
 * One figure could not be checked from this sandbox, which CBC refuses:
 * "only 26 per cent named independence", attributed to an Abacus Data
 * survey of 4 to 7 September 2026 via CBC. Abacus's own February release
 * puts 26 percent in favour of sovereignty, and its September release
 * reports 24 to 27 percent choosing to start the process; a question about
 * motives among leaners was not found. It stands as the author's cited
 * claim; the owner should confirm it against the CBC story before quoting
 * it elsewhere.
 *
 * Two things about the edition itself. The paper says "On Monday, Albertans
 * voted", about the referendum of 19 October 2026, so it is dated 20 October
 * and must not go live before then; the sentence states no result, so it
 * holds either way. And the register numbers it 03: the author's file said
 * 02, but No. 02 has been live since 14 October, and the register exists so
 * that two papers never carry one number.
 *
 * Form, not words: the page's full-bleed red field ("Each province alone is
 * a vassal") is set as the site's red-rule pull line, because the long-form
 * column has no red field and the design system allows one per document;
 * the cost and fund comparisons are BarTables and a facts list rather than
 * CSS bars; the four diagrams are the author's SVGs with their classes
 * mapped to the site's tokens and their scroll animations removed; the
 * progress bar, the Google Fonts link and its script are not carried over.
 */
---
<Read
  slug="common-barrel"
  description={"A proposal for a Canadian refinery owned in layers: by the producers who fill it, the pensions that fund it, First Nations partners, and any Canadian who wants a share."}
  standfirst={"Canada ships its crude south to be refined, then buys fuel back. Here is a proposal to own the refinery instead, together."}
>
      <p class="byline">Jesse James · Northern Temper. A proposal for Canadian ownership, October 2026. <a href="#sources">The receipts are at the end.</a></p>

      <h2><span class="eyebrow">One · The round trip</span> We ship the barrel south. We buy the fuel back.</h2>
      <figure class="diagram">
        <svg viewBox="0 0 400 330" role="img" aria-labelledby="rt-t rt-d">
          <title id="rt-t">The round trip</title>
          <desc id="rt-d">Crude from the oil sands travels south across the border to be refined in the United States, and fuel travels back north to Canadian pumps.</desc>
          <line x1="12" y1="176" x2="388" y2="176" class="s-hair" stroke-width="1.5" stroke-dasharray="4 6"/>
          <text x="16" y="164" class="sm mu-t">Canada</text>
          <text x="16" y="198" class="sm mu-t">United States</text>
          <circle cx="96" cy="78" r="7" class="f-red"/>
          <text x="96" y="52" text-anchor="middle" class="ttl fg-t">OIL SANDS CRUDE</text>
          <circle cx="304" cy="78" r="7" class="f-data"/>
          <text x="304" y="52" text-anchor="middle" class="ttl fg-t">CANADIAN PUMPS</text>
          <circle cx="200" cy="270" r="7" class="f-fg"/>
          <text x="200" y="306" text-anchor="middle" class="ttl fg-t">U.S. REFINERIES</text>
          <path class="s-red" d="M96 90 C96 190 140 262 182 267" fill="none" stroke-width="5"/>
          <polygon class="f-red" points="179,259 193,268 179,276"/>
          <path class="s-data" d="M214 268 C258 262 304 192 304 98" fill="none" stroke-width="3"/>
          <polygon class="f-data" points="297,100 304,87 311,100"/>
          <text x="112" y="130" class="sm mu-t">crude, south</text>
          <text x="289" y="130" text-anchor="end" class="sm mu-t">fuel, north</text>
        </svg>
        <figcaption>Figure 1 · The round trip. Nearly nine barrels in ten of the crude Canada exports go to the United States to be refined, and Canada still buys refined products from American suppliers.<sup><a href="#note-1">1</a></sup></figcaption>
      </figure>
      <p>On Monday, Albertans voted on whether to start down the road to leaving Canada.<sup><a href="#note-2">2</a></sup> Two weeks earlier, Quebec elected a Parti Québécois government that has promised a referendum of its own, though not before 2029.<sup><a href="#note-3">3</a></sup></p>
      <p>Six weeks before the vote, a pollster asked Albertans leaning toward the separation option what was driving them. Only 26 per cent named independence.<sup><a href="#note-4">4</a></sup></p>
      <p>The rest had other reasons. I read that as people sending a message, and I think the message deserves a better answer than a slogan. Here is mine.</p>

      <h2><span class="eyebrow">Two · The case against</span> The skeptics have a point.</h2>
      <p>Let me start with the strongest argument against what I’m about to propose, because it’s a good one.</p>
      <p>When B.C.’s premier floated a new Canadian refinery in January, a UBC business lecturer called it “not an economically justifiable or feasible idea.”<sup><a href="#note-5">5</a></sup></p>
      <p>Alberta’s last new refinery is the best evidence for his side. Sturgeon was estimated at $5.7 billion when it was approved in 2012. It finished at more than $10 billion, for a plant that processes roughly 78,000 barrels a day.<sup><a href="#note-6">6</a>, <a href="#note-7">7</a>, <a href="#note-8">8</a></sup></p>
      <dl class="facts">
        <div><dt>$5.7B</dt><dd>Estimate when approved, 2012.<sup><a href="#note-6">6</a></sup></dd></div>
        <div><dt>Over $10B</dt><dd>Final cost, Alberta’s Sturgeon refinery.<sup><a href="#note-7">7</a>, <a href="#note-8">8</a></sup></dd></div>
      </dl>
      <p>If we build a refinery the way that one was built, the skeptics will be right. So the real question isn’t whether Canada should refine more of its own oil. <strong>It’s who should own the refinery, and how it gets built.</strong></p>

      <h2><span class="eyebrow">Three · The farmers’ answer</span> Farmers solved this once.</h2>
      <p>In 1933, Ottawa put a tariff of 3.7 cents a gallon on American gasoline, and the small prairie fuel co-ops lost their cheap supply. They could also see the big oil companies moving the profit into refining, where the co-ops had no seat.<sup><a href="#note-9">9</a></sup></p>
      <p>So that winter, they started a drive to build their own refinery.</p>
      <figure class="timeline" aria-labelledby="fig-2">
        <figcaption id="fig-2" class="fig">Figure 2 · The Co-op refinery, from a tariff to today</figcaption>
        <ol>
          <li>
            <p class="yr">1933</p>
            <p class="tag">The squeeze</p>
            <p>A new tariff cuts prairie fuel co-ops off from cheap American gasoline.<sup><a href="#note-9">9</a></sup></p>
          </li>
          <li>
            <p class="yr">1935</p>
            <p class="tag">The answer</p>
            <p>In the refinery’s own telling, eight farmers get it started in Regina.<sup><a href="#note-10">10</a></sup></p>
          </li>
          <li>
            <p class="yr">130,000</p>
            <p class="tag">Barrels a day, today</p>
            <p>More than 1,000 people work there. It is owned through Federated Co-operatives by about 160 local co-ops.<sup><a href="#note-11">11</a>, <a href="#note-12">12</a></sup></p>
          </li>
        </ol>
      </figure>
      <p>Nobody got rich flipping shares in it. That was never the point. <strong>The people who use it own it, and nobody else can buy it out from under them.</strong></p>

      <h2><span class="eyebrow">Four · What changed</span> The money is already looking.</h2>
      <p>The farmers had to raise every dollar themselves. We don’t.</p>
      <p>In April, Ottawa launched the Canada Strong Fund, a $25 billion sovereign wealth fund that invests alongside private capital on equal terms. It plans a retail product so any Canadian can put in savings, with the initial capital protected. The details are still being designed.<sup><a href="#note-13">13</a>, <a href="#note-14">14</a></sup></p>
      <p>Canada’s big pension funds are bringing money home too.</p>
      <BarTable name="Figure 3" rowHead="Commitment" columns={['Billions of dollars']} unit="billions" rows={[
        { label: 'Maple Fund, CPP Investments and Brookfield, five years', values: [50] },
        { label: 'Canada Strong Fund, federal, three years', values: [25] },
        { label: 'Ontario Teachers’, by the end of 2027', values: [10] },
        { label: 'OMERS, at least, over five years', values: [10] },
      ]}>Figure 3 · Commitments announced in 2026 for Canadian investment. Time frames differ, and none of it is earmarked for refining.<sup><a href="#note-13">13</a>, <a href="#note-15">15</a>, <a href="#note-16">16</a>, <a href="#note-17">17</a></sup></BarTable>
      <p>The money is looking for projects. <strong>The question is who ends up owning them.</strong></p>

      <h2><span class="eyebrow">Five · The structure</span> Owned in layers.</h2>
      <p>Here is the structure I’m proposing. I call it Common Barrel: one refinery, held in a partnership, owned in layers.</p>
      <figure class="diagram">
        <svg viewBox="0 0 400 330" role="img" aria-labelledby="ly-t ly-d">
          <title id="ly-t">Who owns Common Barrel</title>
          <desc id="ly-d">A producers’ co-op, pension funds, First Nations partners and the Canada Strong Fund hold equity in the Common Barrel partnership, lenders provide debt and are paid first, and the partnership owns the refinery.</desc>
          <rect x="10" y="24" width="10" height="10" class="f-red"/>
          <text x="28" y="34" class="ttl fg-t">PRODUCERS’ CO-OP</text>
          <text x="28" y="52" class="sm mu-t">one vote per member</text>
          <rect x="10" y="78" width="10" height="10" class="f-red"/>
          <text x="28" y="88" class="ttl fg-t">PENSION FUNDS</text>
          <text x="28" y="106" class="sm mu-t">paid by contract</text>
          <rect x="10" y="132" width="10" height="10" class="f-red"/>
          <text x="28" y="142" class="ttl fg-t">FIRST NATIONS</text>
          <text x="28" y="160" class="sm mu-t">owners from day one</text>
          <rect x="10" y="186" width="10" height="10" class="f-red"/>
          <text x="28" y="196" class="ttl fg-t">CANADA STRONG FUND</text>
          <text x="28" y="214" class="sm mu-t">same terms as all</text>
          <rect x="10" y="240" width="10" height="10" class="f-data"/>
          <text x="28" y="250" class="ttl fg-t">LENDERS</text>
          <text x="28" y="268" class="sm mu-t">paid first</text>
          <path d="M200 29 C216 29 214 150 230 150" fill="none" class="s-fg" stroke-width="1.25"/>
          <path d="M200 83 C216 83 214 150 230 150" fill="none" class="s-fg" stroke-width="1.25"/>
          <path d="M200 137 C216 137 214 150 230 150" fill="none" class="s-fg" stroke-width="1.25"/>
          <path d="M200 191 C216 191 214 150 230 150" fill="none" class="s-fg" stroke-width="1.25"/>
          <path d="M200 245 C216 245 214 150 230 150" fill="none" class="s-data" stroke-width="1.5" stroke-dasharray="4 4"/>
          <rect x="232" y="118" width="156" height="64" class="f-panel s-red" stroke-width="2"/>
          <text x="310" y="147" text-anchor="middle" class="ttl fg-t">COMMON BARREL</text>
          <text x="310" y="167" text-anchor="middle" class="sm mu-t">the partnership</text>
          <line x1="310" y1="182" x2="310" y2="240" class="s-muted" stroke-width="1.5"/>
          <polygon points="303,238 310,250 317,238" class="f-fg"/>
          <rect x="232" y="252" width="156" height="58" class="f-panel s-hair" stroke-width="1.5"/>
          <text x="310" y="279" text-anchor="middle" class="ttl fg-t">THE REFINERY</text>
          <text x="310" y="298" text-anchor="middle" class="sm mu-t">Canadian-owned</text>
        </svg>
        <figcaption>Figure 4 · Who owns Common Barrel. Solid lines are ownership. The dashed line is debt, which is repaid before anyone else is paid.</figcaption>
      </figure>
      <p><strong>Producers join through a co-op.</strong> They buy in by the barrel they commit, get paid by the barrel they deliver, and get one vote each. Saskatchewan already has a law for exactly this kind of co-op, and under that model members’ own money typically covers 35 to 50 per cent of start-up costs.<sup><a href="#note-18">18</a>, <a href="#note-19">19</a></sup></p>
      <p><strong>Pension funds come in as partners,</strong> paid through processing fees set by contract instead of bets on fuel prices. Pension funds favour infrastructure because it pays returns that keep pace with inflation.<sup><a href="#note-20">20</a></sup></p>
      <p><strong>First Nations hold equity as owners from the start,</strong> on terms they set with us rather than terms written for them.</p>
      <p><strong>The Canada Strong Fund takes a stake</strong> on the same terms as everyone else. Any Canadian who buys its retail product would own a slice.</p>
      <p><strong>Lenders get paid first.</strong> Everyone else gets paid in a set order, written down before construction starts.</p>

      <h2><span class="eyebrow">Six · Control</span> Nobody can buy control.</h2>
      <p>In an ordinary company, votes follow money. Whoever owns the most shares runs it, and can sell it.</p>
      <figure class="diagram">
        <svg viewBox="0 0 400 190" role="img" aria-labelledby="ct-t ct-d">
          <title id="ct-t">Votes in a company versus a co-op</title>
          <desc id="ct-d">In an ordinary company, one large investor outvotes four small ones. In a co-op, five members each hold one equal vote.</desc>
          <line x1="200" y1="14" x2="200" y2="176" class="s-hair" stroke-width="1"/>
          <text x="96" y="26" text-anchor="middle" class="ttl fg-t">ORDINARY COMPANY</text>
          <text x="96" y="44" text-anchor="middle" class="sm mu-t">votes follow money</text>
          <circle cx="58" cy="108" r="34" class="f-red"/>
          <circle cx="122" cy="92" r="9" class="f-inert"/>
          <circle cx="150" cy="92" r="9" class="f-inert"/>
          <circle cx="122" cy="124" r="9" class="f-inert"/>
          <circle cx="150" cy="124" r="9" class="f-inert"/>
          <text x="96" y="170" text-anchor="middle" class="sm mu-t">one investor outvotes the rest</text>
          <text x="304" y="26" text-anchor="middle" class="ttl fg-t">CO-OP</text>
          <text x="304" y="44" text-anchor="middle" class="sm mu-t">one member, one vote</text>
          <circle cx="236" cy="108" r="14" class="f-data"/>
          <circle cx="270" cy="108" r="14" class="f-data"/>
          <circle cx="304" cy="108" r="14" class="f-data"/>
          <circle cx="338" cy="108" r="14" class="f-data"/>
          <circle cx="372" cy="108" r="14" class="f-data"/>
          <text x="304" y="170" text-anchor="middle" class="sm mu-t">no one can buy control</text>
        </svg>
        <figcaption>Figure 5 · Votes in a company versus a co-op.</figcaption>
      </figure>
      <p>In a co-op, every member gets one vote no matter how much they put in. A big producer is paid in proportion to its barrels, but it can’t take over. <strong>Under Common Barrel, selling the refinery would need the producers’ co-op to agree.</strong></p>

      <h2><span class="eyebrow">Seven · Payment</span> Proof before payment.</h2>
      <p>One modern piece belongs in this. When a producer’s crude crosses the meter at the refinery gate, three records already exist: the meter’s reading, the pipeline’s ticket, and an independent inspector’s report.</p>
      <p>Put those records on a shared ledger and payment follows automatically when two of the three agree. If one disagrees, the payment waits for a person to look.</p>
      <figure class="diagram">
        <svg viewBox="0 0 400 300" role="img" aria-labelledby="pf-t pf-d">
          <title id="pf-t">Proof before payment</title>
          <desc id="pf-d">The gate meter, the pipeline ticket and the inspector’s report are compared. If two of three agree, payment is released to the producer. If not, the payment waits while a person reviews it.</desc>
          <rect x="8" y="18" width="120" height="52" class="f-panel s-hair" stroke-width="1.25"/>
          <text x="68" y="42" text-anchor="middle" class="ttl fg-t">GATE METER</text>
