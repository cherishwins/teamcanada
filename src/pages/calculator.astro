---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Share from '../components/Share.astro';
import { getProvinces } from '../lib/sources';
import {
  FEDERAL_DEBT, FRICTION_LOW, FRICTION_HIGH,
  BUILD_STATE_LOW_B, BUILD_STATE_HIGH_B, NATO_PCT, NATO_DIRECT_PCT,
} from '../lib/figures';

const { provinces, canadaPopulation, popAsOf, allLive } = await getProvinces();

/**
 * The Alberta Prosperity Project costed an Alberta state at $98-107B. Other
 * provinces are scaled per person from that, and the person count is Alberta's
 * in the SAME dataset the page uses, so Alberta reproduces the published range
 * exactly. It used to divide by a typed 5,057,077 (an old quarter's estimate)
 * and printed $99-108B beside the words "the APP's own $98-107B estimate".
 */
const buildBasePop = provinces.find((p) => p.code === 'AB')!.population;
const quarter = (iso: string) => `Q${Math.floor((+iso.slice(5, 7) - 1) / 3) + 1} ${iso.slice(0, 4)}`;

/**
 * Every constant here is published and cited on the page itself. The
 * calculator's only claim is arithmetic: it does not estimate anything it
 * cannot show the source for, and each line states its own method. Every
 * sourced value comes from src/lib/figures.ts, the one place a hand-entered
 * number on this site is written; the one assumption of this page's own, the
 * markup for a negotiation going badly, is named below and printed from here.
 */
const DEBT_HIGH_MARKUP = 0.15;

const sorted = [...provinces].sort((a, b) => b.gdp - a.gdp);
const gdpYear = provinces[0]?.gdpYear ?? '2024';

/**
 * The arithmetic exists once, here, and runs at build time for EVERY province.
 *
 * It used to run twice: once here for the default province, and again in an
 * inline script that carried the live StatCan population in its source via
 * define:vars. Two copies of the math could drift, and worse, the script's CSP
 * hash moved whenever StatCan published a new quarter or timed out during a
 * build, so the next deploy after either failed check-csp. Now each <option>
 * carries its province's finished lines as text and the script only swaps it
 * in. No figure is in the script, so its hash cannot move with the data, and
 * the page reads the same with scripting off: the default province is rendered
 * from the same function.
 */
function bill(pop: number, gdpM: number) {
  const lossLow = gdpM * FRICTION_LOW;
  const lossHigh = gdpM * FRICTION_HIGH;
  const debtLow = FEDERAL_DEBT.value * 1000 * (pop / canadaPopulation);
  const debtHigh = debtLow * (1 + DEBT_HIGH_MARKUP);
  const buildLow = ((BUILD_STATE_LOW_B * 1000) / buildBasePop) * pop;
  const buildHigh = ((BUILD_STATE_HIGH_B * 1000) / buildBasePop) * pop;
  const natoLow = gdpM * NATO_DIRECT_PCT;
  const natoHigh = gdpM * NATO_PCT;
  const totLow = debtLow + buildLow;
  const totHigh = debtHigh + buildHigh;
  const recurring = lossLow + natoHigh;
  return { lossLow, lossHigh, debtLow, debtHigh, buildLow, buildHigh,
           natoLow, natoHigh, totLow, totHigh, recurring };
}
const big = (m: number) => {
  const b = m / 1000;
  return b >= 1 ? `$${b.toFixed(b < 10 ? 1 : 0)}B` : `$${Math.round(m)}M`;
};
const cad = new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD', maximumFractionDigits: 0 });
const pct = (x: number) => `${Number((x * 100).toFixed(1))}%`;

/** Each element id the script fills, in the order every option lists its text. */
const IDS = ['totalFirstYear', 'perPerson', 'annualLoss', 'lossLow', 'lossHigh', 'debtLow', 'debtHigh',
             'buildLow', 'buildHigh', 'natoLow', 'natoHigh', 'totLow', 'totHigh', 'flatPer'] as const;
type Lines = Record<(typeof IDS)[number], string>;

function lines(p: { population: number; gdp: number }): Lines {
  const b = bill(p.population, p.gdp);
  return {
    totalFirstYear: big(b.totLow),
    perPerson: cad.format((b.recurring * 1e6) / p.population),
    annualLoss: `${big(b.recurring)}/yr`,
    lossLow: big(b.lossLow), lossHigh: big(b.lossHigh),
    debtLow: big(b.debtLow), debtHigh: big(b.debtHigh),
    buildLow: big(b.buildLow), buildHigh: big(b.buildHigh),
    natoLow: big(b.natoLow), natoHigh: big(b.natoHigh),
    totLow: big(b.totLow), totHigh: big(b.totHigh),
    flatPer: cad.format((b.totLow * 1e6) / p.population),
  };
}
// '|' never occurs in a formatted amount, so it can separate them.
const packed = (p: { population: number; gdp: number }) => {
  const l = lines(p);
  return IDS.map((id) => l[id]).join('|');
};

/**
 * The default province is computed here, not only in the browser. Without this
 * the page renders a table of em-dashes for anyone with JS off or blocked, and
 * for every crawler — which contradicts the rule the rest of the site follows:
 * nothing may depend on scripting to be readable. Script only handles changes.
 */
const DEFAULT = provinces.find((p) => p.code === 'AB') ?? sorted[0];
const v = lines(DEFAULT);

const description =
  'Pick a province and see the bill. Trade friction, federal debt share, the ' +
  'cost of building a state from zero, and the defence floor — from StatCan figures.';
---
<Base title="The Bill" description={description} path="/calculator" ogImage="/og/calculator.png">
  <Nav />
  <main id="main">
    <section class="open">
      <div class="nt-wrap">
        <div class="nt-label">Run the numbers yourself</div>
        <hr class="nt-rule" />
        <h1 class="nt-display lg">Pick a province.<br />See the bill.</h1>
        <p class="nt-lede" style="margin-top:var(--space-4);">
          Nothing here is a projection. It is arithmetic on published figures,
          and every line shows its own working.
        </p>
      </div>
    </section>

    <section class="nt-light">
      <div class="nt-wrap">
        <div class="picker">
          <label class="nt-label" for="prov">Province</label>
          <select id="prov" name="prov" data-ids={IDS.join(' ')}>
            {sorted.map((p) => (
              <option value={p.code} selected={p.code === DEFAULT.code}
                      data-bill={packed(p)}>{p.name}</option>
            ))}
          </select>
        </div>

        <div class="headline">
          <div class="hl">
            <div class="hn" id="totalFirstYear">{v.totalFirstYear}</div>
            <div class="hk">Day-one bill, low estimate</div>
          </div>
          <div class="hl">
            <div class="hn" id="perPerson">{v.perPerson}</div>
            <div class="hk">Per resident, every year after</div>
          </div>
          <div class="hl">
            <div class="hn" id="annualLoss">{v.annualLoss}</div>
            <div class="hk">Recurring, every year after</div>
          </div>
        </div>

        <table class="bill">
          <caption class="nt-caption">All figures in Canadian dollars. Low and high reflect the published ranges, not a guess.</caption>
          <thead>
            <tr><th scope="col">Line</th><th scope="col">Low</th><th scope="col">High</th><th scope="col">How it is calculated</th></tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Lost output, per year</th>
              <td id="lossLow">{v.lossLow}</td><td id="lossHigh">{v.lossHigh}</td>
              <td class="how">{pct(FRICTION_LOW)} of provincial GDP at a 5% rise in trade friction with the rest of Canada; {pct(FRICTION_HIGH)} at 8% friction. <span class="cite">Tombe, University of Calgary</span></td>
            </tr>
            <tr>
              <th scope="row">Share of federal debt</th>
              <td id="debtLow">{v.debtLow}</td><td id="debtHigh">{v.debtHigh}</td>
              <td class="how">Population share of the {FEDERAL_DEBT.display} federal accumulated deficit. The high column adds {pct(DEBT_HIGH_MARKUP)} for the negotiation going badly. <span class="cite">{FEDERAL_DEBT.source}, {FEDERAL_DEBT.period}</span></td>
            </tr>
            <tr>
              <th scope="row">Building a state from zero</th>
              <td id="buildLow">{v.buildLow}</td><td id="buildHigh">{v.buildHigh}</td>
              <td class="how">Army, navy, air force, coast guard, central bank, passports, borders, customs, foreign service. Scaled per person from the Alberta Prosperity Project's own ${BUILD_STATE_LOW_B}–{BUILD_STATE_HIGH_B}B estimate. <span class="cite">APP, fully costed plan</span></td>
            </tr>
            <tr>
              <th scope="row">Defence, per year</th>
              <td id="natoLow">{v.natoLow}</td><td id="natoHigh">{v.natoHigh}</td>
              <td class="how">{pct(NATO_PCT)} of GDP, the NATO pledge adopted at the Hague in 2025. The low column is the {pct(NATO_DIRECT_PCT)} direct-military portion. <span class="cite">NATO Hague summit, 2025</span></td>
            </tr>
            <tr class="tot">
              <th scope="row">Day one, before anything is built</th>
              <td id="totLow">{v.totLow}</td><td id="totHigh">{v.totHigh}</td>
              <td class="how">Debt share plus standing up a state. The output loss and the defence bill recur every year afterwards.</td>
            </tr>
          </tbody>
        </table>

        <div class="flat">
          <p class="nt-label">A thing worth noticing</p>
          <p>
            The day-one bill per resident lands at roughly
            {' '}<strong id="flatPer">{v.flatPer}</strong> whichever province you pick. That is
            not a coincidence and it is not a bug: both of its parts — the share
            of federal debt and the cost of standing up a state — scale with
            population. <strong>Leaving costs about the same per person
            everywhere.</strong> What differs is what each province gives up
            afterwards, which is the number above it.
          </p>
        </div>

        <div class="caveat">
          <p class="nt-label">What this leaves out</p>
          <p>Treaty obligations, environmental closure liabilities, currency reserves, and the cost of the negotiation itself. Alberta's oil and gas closure liability alone runs from $36.6B on the regulator's books to $260B in its own worst-case slide. <strong>Every omission here makes separation look cheaper than it is.</strong></p>
        </div>

        <p class="nt-caption src" data-live={String(allLive)}>
          Population · Statistics Canada 17-10-0009, {quarter(popAsOf)}; each province's share of the
          debt is of Canada's population, territories included ·
          GDP · Statistics Canada 36-10-0222, {gdpYear}, current prices
          {!allLive && <span data-live-note>{' '}· Statistics Canada is not responding; the last published figures are shown</span>}
        </p>
      </div>
    </section>

    <Share quote={"Pick a province and see the bill. Trade friction, federal debt share, the cost of building a state from zero — arithmetic on published figures, every line showing its working."} />
  </main>
  <SiteFooter />
</Base>

<style>
  .open { padding-block: clamp(70px, 13vh, 180px); }
  .open h1 { max-width: 13ch; }

  .picker { display: flex; flex-direction: column; gap: .6rem; max-width: 24rem; }
  select {
    font-family: var(--font-display); font-weight: var(--fw-display);
    text-transform: uppercase; font-size: clamp(18px, 2.6vw, 30px);
    background: var(--nt-white); color: var(--nt-black);
    border: 0; border-bottom: var(--rule-weight) solid var(--nt-red);
    border-radius: var(--radius); padding: 10px 2px; min-height: 48px;
    appearance: none; cursor: pointer; width: 100%;
  }
  select:focus-visible { outline: var(--focus-ring); outline-offset: 2px; }

  .headline {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--gap-grid); margin: clamp(38px, 6vh, 74px) 0;
  }
  .hn {
    font-family: var(--font-display); font-weight: var(--fw-display);
    font-size: clamp(34px, 5.4vw, 74px); line-height: .88;
    color: var(--nt-red); font-variant-numeric: tabular-nums; letter-spacing: var(--ls-number);
  }
  .hk {
    font-family: var(--font-display); font-weight: var(--fw-label);
    font-size: var(--type-label-sm); letter-spacing: var(--ls-key); text-transform: uppercase;
    margin-top: .7rem; padding-top: .7rem; border-top: var(--border-key) solid var(--border-hairline);
  }

  .bill { width: 100%; border-collapse: collapse; margin-top: clamp(24px, 4vh, 48px); }
  caption { text-align: left; padding-bottom: var(--space-2); }
  .bill th[scope='col'] {
    background: var(--nt-black); color: var(--nt-white); text-align: left;
    font-family: var(--font-display); font-weight: var(--fw-label);
    font-size: var(--type-label-sm); letter-spacing: var(--ls-key);
    text-transform: uppercase; padding: 11px 13px;
  }
  .bill td, .bill th[scope='row'] {
    border-bottom: var(--border-hair) solid var(--border-hairline);
    padding: 14px 13px; vertical-align: top; text-align: left;
  }
  .bill th[scope='row'] { font-weight: var(--fw-body-strong); width: 22%; }
  .bill td:nth-child(2), .bill td:nth-child(3) {
    font-family: var(--font-display); font-weight: var(--fw-display);
    font-variant-numeric: tabular-nums; font-size: var(--type-number-sm); white-space: nowrap;
  }
  .how { font-size: var(--type-body-sm); color: var(--text-muted); }
  .cite { display: block; margin-top: .35rem; font-family: var(--font-display);
    font-weight: var(--fw-label); font-size: 10.5px; letter-spacing: var(--ls-caption);
    text-transform: uppercase; color: var(--nt-red); }
  .tot th[scope='row'], .tot td { border-top: var(--border-key) solid var(--nt-black); font-weight: var(--fw-body-strong); }

  /* The table is the content; on a phone it becomes stacked rows rather than
     a horizontal scroll, because a four-column bill is unreadable at 320px. */
  @media (max-width: 760px) {
    .bill, .bill tbody, .bill tr, .bill td, .bill th { display: block; width: auto; }
    .bill thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    /* A table-caption inside a display:block table shrinks to its longest word:
       64px wide and one word per line at 390px, measured. */
    .bill caption { display: block; width: auto; }
    .bill tr { border-bottom: var(--border-key) solid var(--border-hairline); padding: var(--space-2) 0; }
    .bill th[scope='row'] { width: auto; border: 0; padding: 0 0 .5rem; font-size: 1.05rem; }
    .bill td { border: 0; padding: 0 0 .4rem; }
    .bill td:nth-child(2)::before { content: 'Low · '; font-family: var(--font-body); font-weight: 400; color: var(--text-muted); font-size: var(--type-body-sm); }
    .bill td:nth-child(3)::before { content: 'High · '; font-family: var(--font-body); font-weight: 400; color: var(--text-muted); font-size: var(--type-body-sm); }
    .how { padding-top: .4rem; }
  }

  .flat {
    margin-top: clamp(34px, 5vh, 64px); padding: clamp(20px, 2.6vw, 30px);
    border-left: var(--rule-weight) solid var(--nt-black); background: #F4F4F4;
  }
  .flat p + p { margin-top: var(--space-2); }
  .caveat {
    margin-top: var(--space-3); padding: clamp(20px, 2.6vw, 30px);
    border-left: var(--rule-weight) solid var(--nt-red); background: #F4F4F4;
  }
  .caveat p + p { margin-top: var(--space-2); }
  .src { margin-top: clamp(26px, 4vh, 46px); }
</style>

<script is:inline>
  // Every province's lines are computed at build time, in the frontmatter, and
  // ride on its <option> as data-bill in the order data-ids names. This only
  // swaps text: no figure lives here, so the CSP hash cannot move with the data.
  (() => {
    const sel = document.getElementById('prov');
    if (!sel) return;
    const ids = (sel.dataset.ids || '').split(' ');
    const render = () => {
      const vals = (sel.selectedOptions[0]?.dataset.bill || '').split('|');
      if (vals.length !== ids.length) return;
      ids.forEach((id, i) => {
        const el = document.getElementById(id);
        if (el) el.textContent = vals[i];
      });
    };
    sel.addEventListener('change', render);
    // A browser that restores form state on reload can show a province other
    // than the one rendered; this brings the figures back in line with it.
    render();
  })();
</script>
