---
import Base from '../../layouts/Base.astro';
import Brouillon from '../../components/Brouillon.astro';
import BearDual from '../../components/marks/BearDual.astro';
import Stat from '../../components/Stat.astro';
import LiveRefresh from '../../components/LiveRefresh.astro';
import { getRivers, getWater } from '../../lib/sources';

/**
 * French, re-authored — not translated.
 *
 * The register follows the house rules: Lagacé by default (first person, dry,
 * concrete, short), Hébert where a mechanism has to be explained, Laferrière
 * for the two moments of warmth. Vouvoiement throughout. Guillemets with
 * non-breaking spaces, no space before ? ! ; — but a narrow no-break space
 * (U+202F) before the colon, which Québec keeps exactly as France does. This
 * comment said "no space before : " for months while tools/check-french.cjs
 * enforced the opposite; the code was right and the note was wrong. Typography
 * is the fastest tell that a page was not written in France or by a machine.
 *
 * The English page leads with Gander. This one leads with le fleuve, because
 * for a reader here the water argument is not an abstraction — it runs past
 * Montréal at nine thousand cubic metres a second and the gauge says so.
 *
 * getFigures() used to be awaited here and its result thrown away — a StatCan
 * round-trip on every build for a binding nothing read. `astro check` found
 * it; nothing else would have, because a wasted fetch that succeeds looks
 * exactly like a fetch that mattered.
 */
const [water, aquastat] = await Promise.all([getRivers(), getWater()]);
const fmt = new Intl.NumberFormat('fr-CA');
// Le rapport se dit avec une virgule décimale, jamais un point.
const dec1 = new Intl.NumberFormat('fr-CA', { minimumFractionDigits: 1, maximumFractionDigits: 1 });

// Cette page imprimait 109 837 m³ contre 9 980 et parlait de onze contre un.
// Les deux chiffres venaient de publications différentes, à des dates
// différentes, et le chiffre canadien divisait son volume par la population de
// son année de parution. Un rapport bâti sur deux millésimes ne se vérifie pas.
// AQUASTAT (FAO) donne les deux pays la même année, avec la même définition.
const km3 = (m3: number) => fmt.format(Math.round(m3 / 1e9));
const ecartPct = Math.abs(aquastat.canada.volume / aquastat.usa.volume - 1) * 100;
const laSalle = water.rivers.find((r) => r.station === '02OA016');
// « Présentement » n’est vrai que si la station transmet. Sinon, la page le dit.
const STATION_MUETTE = ' La station ne transmet pas en ce moment; voici sa dernière lecture.';

const description =
  'Ce que nous sommes. Ce que nous détenons. Et ce dont nous ne nous sommes ' +
  'jamais servis contre un voisin, alors que nous aurions toujours pu.';
---
<Base
  title="La trempe du Nord"
  description={description}
  path="/fr"
  ogImage="/og/fr.png"
  lang="fr-CA"
  noindex
>
  <Brouillon />

  <header class="hero">
    <div class="aurora" aria-hidden="true"></div>
    <div class="hero-inner">
      <div class="hero-figure">
        <BearDual class="hero-bear" alt="Deux ours polaires dos à dos, épaules soudées, la tête tournée vers l’extérieur." />
      </div>
      <h1 class="nt-display xl">La trempe<br />du Nord</h1>
      <div class="band" aria-hidden="true"></div>
      <p class="sub">
        Ce que nous sommes. Ce que nous détenons. Et ce dont nous ne nous sommes
        jamais servis contre un voisin, alors que nous aurions toujours pu.
      </p>
      <div class="nt-stamp">
        Un état de caractère<br />
        Publié pendant une guerre commerciale
      </div>
    </div>
  </header>

  <main id="main">
    <!-- ===== I · le fleuve ===== -->
    <section class="nt-light">
      <div class="nt-wrap">
        <div class="nt-label">Un · Le fleuve</div>
        <hr class="nt-rule" />
        <h2 class="nt-display lg">La même<br />eau.</h2>

        <div class="nt-prose">
          <p data-rivers><strong data-live={String(laSalle!.live)}>Présentement, à LaSalle, le fleuve passe à <span data-river="02OA016">{fmt.format(Math.round(laSalle!.discharge))}</span> mètres cubes par seconde.</strong> Une station de jaugeage le mesure aux cinq minutes. Ce n’est pas une image. C’est une lecture.<span data-live-note data-ok="" data-fallback={STATION_MUETTE}>{laSalle!.live ? '' : STATION_MUETTE}</span></p>
          <p>Le Canada et les États-Unis produisent presque exactement la même quantité d’eau douce renouvelable chaque année : {km3(aquastat.canada.volume)} kilomètres cubes contre {km3(aquastat.usa.volume)}, un écart de {ecartPct.toFixed(0)} %. Par personne, le rapport est de {dec1.format(aquastat.ratio)} contre un — parce que nous sommes bien moins nombreux à nous la partager.</p>
          {!aquastat.live && <p class="nt-caption" data-live="false"><span data-live-note>Une source ne répond pas; les derniers chiffres vérifiés sont affichés.</span></p>}
          <p>Nous partageons les plus grands lacs de la planète avec les gens de l’autre rive depuis deux cents ans. Pas une fois nous n’avons laissé entendre qu’il y avait un robinet.</p>
          <p>Personne ne l’a proposé sérieusement. Personne ne le proposera, parce qu’un pays qui ferait cela serait un autre pays que celui-ci, et nous n’avons pas envie de le devenir pour gagner une discussion.</p>
          <p><strong>Ce n’est pas de la faiblesse. C’est exactement l’affaire.</strong></p>
        </div>

        <details class="vintage rv">
          <summary>Cette page disait « onze fois »</summary>
          <div class="vbody">
            <p>
              C’est vrai, et le chiffre ne tenait pas. Il venait de la division
              de 109 837 m³ par 9 980 — deux chiffres publiés séparément, à des
              dates différentes, calculés autrement. Le chiffre canadien
              divisait son volume par la population de son année de parution,
              soit environ 31,7 millions de personnes. C’est le Canada de 1998.
            </p>
            <p>
              <strong>L’eau n’a pas changé. C’est le diviseur qui a
              changé</strong> — et un rapport bâti sur deux millésimes n’est pas
              un chiffre vérifiable, quoi qu’il dise. Les chiffres ci-dessus
              viennent plutôt d’AQUASTAT (FAO) : une seule source, une seule
              année de référence ({aquastat.year}), la même définition des deux
              côtés de la frontière. Le rapport est calculé à partir de ces deux
              chiffres, jamais saisi à la main.
            </p>
            <p>
              C’est un chiffre plus petit que celui que nous imprimions. C’est
              aussi un chiffre que n’importe qui peut vérifier en une seule
              requête, ce qui vaut davantage.
              {' '}<a href="/api/water.json" data-astro-prefetch="false">Voici le point d’accès.</a>
            </p>
            <p>
              Cela ne touche pas les affirmations qui n’ont aucun diviseur :
              563 lacs de plus de 100 km², le quart des milieux humides de la
              planète. Ce sont des volumes, et ils tiennent.
            </p>
            <p class="nt-caption">
              Nous préférons le signaler nous-mêmes qu’on nous le fasse remarquer.
            </p>
          </div>
        </details>

        <div class="trio">
          <Stat value={fmt.format(aquastat.canada.perCapita)} label="Mètres cubes, par personne" note={"Eau douce renouvelable produite chaque année au Canada. Source : AQUASTAT (FAO), " + aquastat.year + "."} />
          <Stat value={fmt.format(aquastat.usa.perCapita)} label="Le même chiffre, au sud" note="Presque le même volume total. Beaucoup plus de monde pour se le partager." />
          <Stat value="40 %" countTo={40} label="De la frontière" note="La plus longue frontière du monde n’est pas un trait sur le sol. C’est de l’eau, et nous la buvons tous les deux." />
        </div>
      </div>
    </section>

    <!-- ===== II · le registre ===== -->
    <section>
      <div class="nt-wrap">
        <div class="nt-label">Deux · Le registre</div>
        <hr class="nt-rule" />
        <h2 class="nt-display md" style="max-width:17ch;">Un compte que personne ici n’a jamais demandé à régler.</h2>

        <div class="nt-prose">
          <p>Le 11 septembre 2001, les Américains ont fermé leur propre ciel. Plus de 33 000 personnes se sont retrouvées au-dessus de l’Atlantique sans nulle part où se poser. Le Canada a ouvert dix-sept aéroports et les a tous pris.</p>
          <p>À Gander, une ville de dix mille habitants à Terre-Neuve, trente-huit gros-porteurs se sont posés. Six mille cinq cents inconnus. Cinq cents chambres d’hôtel en tout. Le reste a dormi dans des sous-sols d’église, des gymnases d’école et des chambres d’amis.</p>
          <p>Personne n’a envoyé de facture. L’idée n’a effleuré personne.</p>
          <p>Cent cinquante-huit Canadiens ont été rapatriés de Kandahar dans une guerre qui a commencé un matin qui n’était pas le nôtre.</p>
        </div>

        <div class="trio">
          <Stat value="33 000" countTo={33000} separated label="Personnes accueillies" note="Sur 224 vols détournés vers dix-sept aéroports canadiens, en une seule après-midi." />
          <Stat value="6 595" countTo={6595} separated label="Hébergés à Gander" note="Dans une ville de dix mille habitants qui comptait environ cinq cents chambres d’hôtel." />
          <Stat value="158" countTo={158} label="Rapatriés de Kandahar" note="Militaires canadiens morts en Afghanistan. L’autoroute depuis Trenton porte leur nom parce que les gens continuaient de se présenter sur les viaducs." />
        </div>
      </div>
    </section>

    <!-- ===== III · la trempe ===== -->
    <section class="nt-redfield">
      <div class="nt-wrap">
        <div class="nt-label">Trois · La trempe</div>
        <hr class="nt-rule" />
        <h2 class="nt-display md" style="max-width:16ch;">La force, c’est ce qu’on choisit de ne pas employer.</h2>

        <div class="nt-prose">
          <p>On trempe l’acier par la chaleur, puis par le froid. Ce qui en sort n’est pas plus mou. C’est plus difficile à casser, et ça garde son tranchant.</p>
          <p>C’est le mot que nous avons choisi et c’est le mot que nous pensons. La trempe, c’est le métal. La trempe, c’est aussi ce qu’on ne perd pas.</p>
          <p>La colère est bruyante et la colère s’épuise. Ce que nous avons à la place est plus froid et dure plus longtemps. C’est ce qui fait déneiger un rang à quatre heures du matin. C’est ce qui fait pousser le char d’un inconnu hors du banc de neige par des gens qui ne se nomment jamais.</p>
          <p><strong>Nous sommes patients parce que l’hiver nous l’a montré. La saison finit toujours par tourner.</strong></p>
        </div>
      </div>
    </section>

    <!-- ===== IV · ce que nous tenons pour vrai ===== -->
    <section class="nt-light">
      <div class="nt-wrap">
        <div class="nt-label">Quatre · Ce que nous tenons pour vrai</div>
        <hr class="nt-rule" />
        <ul class="creed">
          <li class="rv">Une frontière est une poignée de main, pas un mur.</li>
          <li class="rv">Une entente est une entente le jour où elle devient difficile à tenir.</li>
          <li class="rv">On ne serre pas la vis à un ami parce qu’on en a les moyens.</li>
          <li class="rv">L’aide se donne avant qu’on la demande, et elle n’arrive pas avec une facture.</li>
          <li class="rv">Nous préférons être sous-estimés que craints.</li>
        </ul>
      </div>
    </section>

    <!-- ===== clôture ===== -->
    <section class="close">
      <div class="nt-wrap">
        <div class="close-mark rv"><BearDual alt="" /></div>
        <p class="nt-display md rv" style="margin-top:clamp(30px,5vh,60px);max-width:21ch;">
          Nous ne demandons pas qu’on nous aime. Nous ne demandons pas qu’on nous sauve. Nous ne demandons à personne au sud de s’excuser.
        </p>
        <p class="rv warm">
          Nous allons simplement continuer d’être le monde qui enverrait encore les avions.
        </p>
        <p class="rv" style="margin-top:var(--space-2);color:var(--text-muted);">
          Et nous laisserons nos voisins décider, à leur rythme et en leur âme et conscience, s’ils sont encore le monde qui les renverrait.
        </p>
      </div>
    </section>

    <section class="sources">
      <div class="nt-wrap">
        <div class="nt-label">Prenez-le</div>
        <hr class="nt-rule" />
        <div class="scols">
          <div>
            <h3 class="sh">L’eau</h3>
            <p>AQUASTAT (FAO), année de référence {aquastat.year}, servi par la Banque mondiale : {fmt.format(aquastat.canada.perCapita)} m³ d’eau douce renouvelable interne par personne par année au Canada contre {fmt.format(aquastat.usa.perCapita)} m³ aux États-Unis, sur des volumes totaux de {km3(aquastat.canada.volume)} et {km3(aquastat.usa.volume)} kilomètres cubes. En direct à <a href="/api/water.json" data-astro-prefetch="false">/api/water.json</a>. Statistique Canada : troisième réserve renouvelable au monde; 563 lacs de plus de 100 km². Les Grands Lacs contiennent environ 18 % du stock mondial d’eau douce de surface. Environ 25 % des milieux humides de la planète. Environ 40 % de la frontière canado-américaine est constituée d’eau. Le débit du fleuve est mesuré en continu par Environnement et Changement climatique Canada.</p>
          </div>
          <div>
            <h3 class="sh">Le registre</h3>
            <p>Transports Canada a recensé plus de 33 000 passagers sur 224 vols détournés vers 17 aéroports canadiens le 11 septembre 2001. Gander a reçu 38 appareils transportant 6 122 passagers et 473 membres d’équipage, dans une ville d’environ 10 000 habitants. Halifax en a reçu 47, le plus grand nombre pour un seul aéroport. 158 militaires canadiens sont morts pendant la mission en Afghanistan, de 2001 à 2014.</p>
          </div>
          <div>
            <h3 class="sh">La suite</h3>
            <p>Ce texte n’est pas une traduction. Il a été écrit en français, à partir des mêmes chiffres. Le reste du site est pour l’instant en anglais seulement; les pages suivront.</p>
            <p>Tout ce que publie ce site est versé au domaine public sous <a href="https://creativecommons.org/publicdomain/zero/1.0/" rel="license">CC0 1.0</a> — le texte, les chiffres, les ours, le code. Copiez-le, traduisez-le, imprimez-le, citez-le au complet, entraînez un modèle dessus. Aucune permission requise, aucune attribution demandée.</p>
          </div>
        </div>
        <p class="nt-caption back"><a href="/">Read this in English →</a></p>
      </div>
    </section>
  </main>
  <LiveRefresh />
</Base>

<style>
  .hero {
    min-height: 88svh; display: flex; flex-direction: column; justify-content: center;
    padding: var(--hero-y-top) var(--gutter) var(--hero-y-bottom);
    overflow: clip; position: relative;
  }
  .aurora {
    position: absolute; inset: -20% -10% auto -10%; height: 70%; z-index: 0; pointer-events: none;
    background: var(--aurora); filter: blur(var(--aurora-blur));
  }
  .hero-inner { width: 100%; max-width: var(--wrap-hero); margin-inline: auto; position: relative; z-index: 1; }
  .hero-figure { height: clamp(74px, 17.5vh, 200px); }
  .hero-figure :global(.hero-bear) { height: 100%; width: auto; }
  .hero h1 { margin-top: clamp(16px, 2.6vh, 34px); }
  .band {
    height: var(--border-band); background: var(--nt-red); width: 100%;
    margin: clamp(14px,2vh,24px) 0 clamp(16px,2.4vh,28px);
  }
  .sub {
    font-size: var(--type-hero-sub); line-height: var(--lh-hero-sub);
    max-width: 32ch; color: var(--nt-n-220);
  }
  .nt-stamp { margin-top: clamp(18px, 2.8vh, 36px); }

  .vintage {
    margin-top: clamp(22px, 3.2vh, 40px); max-width: 62ch;
    border-top: var(--border-hair) solid var(--border-hairline);
  }
  .vintage summary {
    cursor: pointer; padding: 14px 0; min-height: 44px;
    display: flex; align-items: center; gap: 10px;
    font-family: var(--font-display); font-weight: var(--fw-label);
    font-size: var(--type-label); letter-spacing: var(--ls-key);
    text-transform: uppercase; color: var(--text-accent);
  }
  .vbody { padding-bottom: var(--space-3); }
  .vbody p { font-size: var(--type-body-sm); color: var(--text-muted); margin-bottom: var(--space-2); }
  .vbody p:last-child { margin-bottom: 0; }

  .trio {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--gap-grid); margin-top: var(--stack-head-body);
  }
  .creed { list-style: none; margin-top: var(--space-4); padding: 0; }
  .creed li {
    font-family: var(--font-display); font-weight: var(--fw-display);
    text-transform: uppercase; font-size: clamp(18px, 2.4vw, 34px); line-height: 1.12;
    padding: clamp(18px, 2.4vh, 30px) 0; max-width: 28ch;
    border-bottom: var(--border-hair) solid var(--border-hairline);
  }
  .creed li:first-child { border-top: var(--border-hair) solid var(--border-hairline); }

  .close { padding-block: clamp(90px, 15vh, 200px); }
  .close-mark { max-width: 540px; color: var(--nt-red); }
  .warm { margin-top: var(--space-4); font-size: clamp(18px,1.7vw,24px); color: var(--nt-n-220); }

  .sources { border-top: var(--border-hair) solid var(--border-hairline); padding-block: clamp(60px,9vh,110px); }
  .scols {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(250px,1fr));
    gap: clamp(26px,3.4vw,56px); margin-top: var(--space-2);
  }
  .sh {
    font-family: var(--font-display); font-weight: var(--fw-label);
    font-size: var(--type-label); letter-spacing: var(--ls-key);
    text-transform: uppercase; color: var(--text-accent); margin-bottom: .9rem;
  }
  .scols p { font-size: var(--type-body-sm); color: var(--text-muted); max-width: none; }
  .scols p + p { margin-top: var(--space-2); }
  .scols a { color: var(--nt-n-220); text-underline-offset: 3px; }
  .back { margin-top: clamp(30px, 4.5vh, 56px); }
  .back a {
    display: inline-flex; align-items: center; min-height: 44px;
    color: var(--text-accent); text-underline-offset: 5px;
  }
</style>
