---
/**
 * LeafSeal — Northern Temper mark, inline so `currentColor` resolves against the
 * surrounding text colour. One file serves the white and the red colourway;
 * external <img> SVG cannot do this, it always resolves currentColor to black.
 */
interface Props {
  /** Decorative marks take alt="" and are hidden from assistive tech. */
  alt?: string;
  class?: string;
}
const { alt = 'A maple leaf inside a circular seal.', class: klass = '' } = Astro.props;
const decorative = alt === '';
