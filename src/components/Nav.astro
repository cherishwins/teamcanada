---
import BearHead from './marks/BearHead.astro';
const { pathname } = Astro.url;
const acts = [
  { href: '/',        label: 'Temper',  num: 'I' },
  { href: '/hand',    label: 'The Hand', num: 'II' },
  { href: '/math',    label: 'The Math', num: 'III' },
  { href: '/bloc',    label: 'The Bloc', num: 'IV' },
  { href: '/build',   label: 'The Build', num: 'V' },
];
// 'page' only on the page itself. A parent section (The record, while reading
// /record/members) is 'true': it is where the reader is, not what they are on.
const here = (h: string) => {
  if (h === '/') return pathname === '/' ? 'page' : undefined;
  if (pathname === h) return 'page';
  return pathname.startsWith(h + '/') ? 'true' : undefined;
};
---
<nav class="nav" aria-label="Primary">
  <a class="brand" href="/" aria-label="Northern Temper — home">
    <BearHead alt="" class="bm" />
    <span class="wm">Northern<br />Temper</span>
  </a>

  <button class="toggle" type="button" aria-expanded="false" aria-controls="navmenu">
    <span class="bars" aria-hidden="true"></span>
    <span class="sr">Menu</span>
  </button>

  <div class="menu" id="navmenu">
    <ul class="acts">
      {acts.map((a) => (
        <li>
          <a href={a.href} aria-current={here(a.href)}>
            <span class="num">{a.num}</span>{a.label}
          </a>
        </li>
      ))}
    </ul>
    <ul class="aux">
      <li><a href="/calculator" aria-current={here('/calculator')}>The bill</a></li>
      <li><a href="/record" aria-current={here('/record')}>The record</a></li>
      <li><a href="/read" aria-current={here('/read')}>The reads</a></li>
      <li><a href="/sources" aria-current={here('/sources')}>Receipts</a></li>
      <li><a href="/join" aria-current={here('/join')}>Coalition</a></li>
      <li><a class="lang" href="/fr" hreflang="fr-CA" lang="fr-CA" aria-current={here('/fr')}>FR</a></li>
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: sticky; top: 0; z-index: 40;
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    padding: 12px var(--gutter);
    /* Plain rgba first so a browser without color-mix() (Safari < 16.2,
       Firefox < 113) still gets an opaque-enough bar. Without a fallback the
       sticky nav renders transparent over the content underneath — unreadable,
       not merely unstyled. */
    background: rgba(0, 0, 0, .92);
    background: color-mix(in srgb, var(--nt-black) 92%, transparent);
    border-bottom: var(--border-hair) solid var(--border-hairline);
  }
  /* Safari before 18 knows only the prefixed property, and an unprefixed test
     is false there, so the prefix inside it never applied. Test either. */
  @supports (backdrop-filter: blur(10px)) or (-webkit-backdrop-filter: blur(10px)) {
    .nav { backdrop-filter: saturate(140%) blur(12px); -webkit-backdrop-filter: saturate(140%) blur(12px); }
  }
  .brand {
    display: flex; align-items: center; gap: 10px; text-decoration: none;
    flex: none; color: var(--nt-white);
    min-height: 44px;            /* WCAG 2.5.8 target size, not just the glyph box */
    padding-block: 4px;
  }
  .brand :global(.bm) { width: 34px; height: auto; flex: none; color: var(--nt-white); }
  .wm {
    font-family: var(--font-display); font-weight: var(--fw-display);
    text-transform: uppercase; font-size: 13px; line-height: .95; letter-spacing: .02em;
  }

  /* The toggle only exists below the breakpoint; above it the menu is always open. */
  .toggle {
    margin-left: auto; display: none; background: none; border: 0; cursor: pointer;
    width: 44px; height: 44px; align-items: center; justify-content: center; color: var(--nt-white);
  }
  .bars, .bars::before, .bars::after {
    display: block; width: 22px; height: 2px; background: currentColor; content: '';
    transition: transform .25s var(--ease), opacity .25s var(--ease);
  }
  .bars::before { transform: translateY(-7px); }
  .bars::after  { transform: translateY(5px); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  .menu { margin-left: auto; display: flex; align-items: center; gap: clamp(14px, 2.2vw, 30px); flex-wrap: wrap; }
  ul { list-style: none; display: flex; gap: clamp(12px, 1.8vw, 26px); flex-wrap: wrap; margin: 0; padding: 0; }
  .aux { padding-left: clamp(12px, 1.8vw, 26px); border-left: var(--border-hair) solid var(--border-hairline); }
  .menu a {
    font-family: var(--font-display); font-weight: var(--fw-label);
    font-size: var(--type-label-sm); letter-spacing: .2em; text-transform: uppercase;
    color: var(--nt-n-420); text-decoration: none;
    display: inline-flex; align-items: baseline; gap: 7px;
    padding: 10px 0; transition: color .2s var(--ease);
  }
  .menu a:hover { color: var(--nt-white); }
  .menu a[aria-current] { color: var(--nt-white); }
  .num { color: var(--text-accent); font-size: 10px; letter-spacing: .12em; }
  /* Every other item clears the 24px minimum target (WCAG 2.2 SC 2.5.8) on text
     width alone; "FR" is two glyphs and lands at 16px on desktop. The mobile
     rule below already gives it the full row. The trailing letter-space after
     the R is padded back on the left so the pair still sits optically centred. */
  .menu a.lang {
    color: var(--text-accent); letter-spacing: .22em;
    min-width: 24px; justify-content: center; padding-left: .22em;
  }
  .menu a.lang:hover { color: var(--nt-white); }
  .menu a[aria-current] .num { color: var(--nt-red-lift); }

  /* Collapsed, the menu is also visibility:hidden, which takes its eleven links
     out of the tab order and the accessibility tree; max-height alone left them
     focusable at zero height, between the toggle and the page. The visibility
     change waits for the collapse to finish, so it still animates. The column
     must not wrap: capped at 70svh on a short phone, a wrapping column pushed
     the last six links into a second column that overflow clipped, and touch
     could not reach them. Without JavaScript none of this applies (see the
     <noscript> rule in Base.astro): the toggle is hidden and the menu stays open. */
  /* The menu collapses wherever the full row cannot sit on one line. It
     fits from 1219px; below that it wrapped under the brand or onto two
     lines, and from 921 to 1239px the sticky nav stood 124 to 184px tall,
     up to a quarter of a laptop screen, with a division link landing
     beneath it. 1280 leaves room for fonts to render a little wider on
     another platform. Base.astro's noscript rule and the matchMedia below
     name the same width; tools/verify.cjs fails if the row wraps anywhere
     it is shown. */
  @media (max-width: 1279px) {
    .toggle { display: flex; }
    .menu {
      flex-basis: 100%; margin-left: 0; flex-direction: column; align-items: flex-start; flex-wrap: nowrap;
      gap: 0; overflow: hidden; max-height: 0; visibility: hidden;
      transition: max-height .3s var(--ease), visibility 0s linear .3s;
    }
    .nav[data-open='true'] .menu {
      max-height: 70svh; overflow-y: auto; visibility: visible;
      transition: max-height .3s var(--ease), visibility 0s;
    }
    ul { flex-direction: column; flex-wrap: nowrap; gap: 0; width: 100%; }
    .aux { padding-left: 0; border-left: 0; border-top: var(--border-hair) solid var(--border-hairline); width: 100%; }
    .menu a { padding: 13px 0; font-size: 13px; width: 100%; }
    /* The desktop rule centres "FR" in its 24px minimum; given the whole row
       here, it sat centred under a column of left-aligned links. */
    .menu a.lang { justify-content: flex-start; padding-left: 0; }
    .nav[data-open='true'] .bars { transform: rotate(45deg); }
    .nav[data-open='true'] .bars::before { opacity: 0; }
    .nav[data-open='true'] .bars::after { transform: rotate(-90deg) translateX(-5px); }
  }
  @media (prefers-reduced-motion: reduce) { .menu { transition: none; } }
</style>

<script>
  // Progressive enhancement: without JS a <noscript> rule in Base.astro hides
  // the toggle and leaves the menu open, so the links never depend on this.
  const nav = document.querySelector<HTMLElement>('.nav');
  const btn = nav?.querySelector<HTMLButtonElement>('.toggle');
  const set = (open: boolean) => {
    if (!nav || !btn) return;
    nav.dataset.open = String(open);
    btn.setAttribute('aria-expanded', String(open));
  };
  btn?.addEventListener('click', () => set(nav!.dataset.open !== 'true'));
  // Escape closes and hands focus back to the toggle.
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.dataset.open === 'true') {
      set(false);
      btn?.focus();
    }
  });
  // Tabbing out of the open menu closes it; otherwise focus moves on to links
  // the open menu is still drawn over.
  nav?.addEventListener('focusout', (e) => {
    if (nav.dataset.open === 'true' && !nav.contains(e.relatedTarget as Node | null)) set(false);
  });
  // Widening past the breakpoint closes it, so it does not come back open.
  matchMedia('(min-width: 1280px)').addEventListener('change', (e) => { if (e.matches) set(false); });
</script>
