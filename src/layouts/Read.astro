---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  /** Shorter <title> only, for a headline that would overrun a tab. See Base. */
  pageTitle?: string;
  description: string;
  /** Caps label above the headline, e.g. "NPSI · Working Paper No. 6". */
  imprint: string;
  /** Standfirst under the headline. */
  standfirst: string;
  path: string;
  dateline?: string;
  ogImage?: string;
  schema?: unknown[];
}
const { title, pageTitle, description, imprint, standfirst, path, dateline, ogImage, schema } = Astro.props;
---
<Base title={title} pageTitle={pageTitle} description={description} path={path} ogImage={ogImage} schema={schema}>
  <Nav />
  <main id="main" class="read">
    <header class="rhead nt-light">
      <div class="nt-wrap">
        <div class="nt-label">{imprint}</div>
        <hr class="nt-rule" />
        <h1 class="nt-display lg">{title}</h1>
        <p class="nt-lede stand">{standfirst}</p>
        {dateline && <p class="nt-caption dl">{dateline}</p>}
      </div>
    </header>

    <article class="body nt-light">
      <div class="nt-wrap col">
        <slot />
      </div>
    </article>
    {/* Anything a read wants OUTSIDE the 68ch column — a share band, most
        likely — goes here, on the site's black ground rather than inside the
        light article. Empty on the reads that do not use it. */}
    <slot name="after" />
  </main>
  <SiteFooter />
</Base>

<style>
  .rhead { padding: clamp(44px, 8vh, 110px) var(--gutter) clamp(30px, 5vh, 60px); }
  .stand { margin-top: var(--space-4); max-width: 34ch; }
  .dl { margin-top: var(--space-3); }
  .body { padding: 0 var(--gutter) clamp(70px, 11vh, 150px); }

  /* One measured column. Long-form is read, not scanned — no two-column
     prose here, which would force the eye back up the page on every para. */
  .col { max-width: 68ch; margin-inline: auto; }

  .col :global(h2) {
    font-family: var(--font-display); font-weight: var(--fw-display);
    text-transform: uppercase; line-height: 1.04;
    font-size: clamp(26px, 3.6vw, 46px);
    margin: clamp(44px, 6vh, 82px) 0 var(--space-3);
    padding-top: var(--space-4);
    border-top: var(--border-key) solid var(--nt-red);
  }
  .col :global(h3) {
    font-family: var(--font-display); font-weight: var(--fw-label);
    text-transform: uppercase; letter-spacing: .06em;
    font-size: clamp(17px, 1.9vw, 23px);
    margin: clamp(30px, 4vh, 52px) 0 var(--space-2);
  }
  /* A heading's kicker ("Letter the First", "Tier I — …") rides inside the
     heading as a block, so the outline carries it and nothing floats loose
     between sections. A section counter ("03 / 06") is decoration: hidden
     from assistive tech, set small at the heading's end. */
  .col :global(h2 .eyebrow), .col :global(h3 .eyebrow) {
    display: block; margin-bottom: var(--space-1);
    font-weight: var(--fw-label); font-size: var(--type-label-sm);
    letter-spacing: var(--ls-key); color: var(--nt-red);
  }
  .col :global(h2 .count) {
    display: block; margin-top: var(--space-1);
    font-weight: var(--fw-label); font-size: var(--type-label-sm);
    letter-spacing: var(--ls-key); color: var(--text-caption);
  }
  .col :global(h4) {
    font-family: var(--font-display); font-weight: var(--fw-label);
    text-transform: uppercase; letter-spacing: .06em; font-size: var(--type-label);
    margin: clamp(26px, 3.4vh, 44px) 0 var(--space-1);
  }
  .col :global(.verdict) {
    display: inline-block; font-family: var(--font-display); font-weight: var(--fw-display);
    text-transform: uppercase; letter-spacing: var(--ls-key); font-size: var(--type-label-sm);
    border: var(--border-key) solid var(--nt-red); color: var(--nt-red); padding: 2px 10px;
  }
  .col :global(.byline) { color: var(--text-muted); font-size: var(--type-body-sm); }
  .col :global(ol.claims li::marker), .col :global(ol.notes li::marker) { color: var(--nt-red); font-weight: var(--fw-body-strong); }
  .col :global(.claims .src) {
    display: block; margin-top: var(--space-1);
    font-family: var(--font-display); font-weight: var(--fw-label); font-size: var(--type-stamp);
    letter-spacing: var(--ls-caption); text-transform: uppercase; color: var(--text-caption);
  }
  .col :global(sup a) { text-decoration: none; padding: 0 2px; }
  .col :global(.compare h4) { margin-top: 0; }
  /* In a household card the figures are a small ledger: label left, amount right. */
  .col :global(.households dl) { display: grid; grid-template-columns: 1fr auto; column-gap: var(--space-2); align-items: baseline; }
  .col :global(.households dt) { margin-top: var(--space-1); }
  .col :global(.households dd) { margin-top: var(--space-1); font-variant-numeric: tabular-nums; font-weight: var(--fw-body-strong); text-align: right; }
  .col :global(.compare dl), .col :global(dl.ledger) { margin: var(--space-2) 0 var(--space-3); }
  .col :global(dl.ledger) { border-left: var(--rule-weight) solid var(--nt-red); padding-left: var(--space-3); }
  .col :global(.stat) { margin: clamp(28px, 4vh, 52px) 0; border-top: var(--border-key) solid var(--nt-red); padding-top: var(--space-3); }
  .col :global(.stat .big) {
    font-family: var(--font-display); font-weight: var(--fw-display);
    font-size: clamp(40px, 6vw, 64px); line-height: .9; color: var(--nt-red); margin: 0;
  }
  .col :global(p) { margin-bottom: var(--space-2); max-width: none; }
  .col :global(p.lead) {
    font-size: var(--type-lede); line-height: var(--lh-lede);
    font-weight: var(--fw-body-medium); margin-bottom: var(--space-4);
  }
  .col :global(a) { color: var(--nt-red); text-underline-offset: 3px; }
  /* A link that is the whole paragraph is a control, not running text. */
  .col :global(p > a:only-child) { display: inline-flex; align-items: center; min-height: 44px; }
  .col :global(strong) { font-weight: var(--fw-body-strong); }

  .col :global(blockquote) {
    margin: clamp(30px, 4.5vh, 56px) 0; padding-left: clamp(18px, 2.4vw, 30px);
    border-left: var(--rule-weight) solid var(--nt-red);
    font-family: var(--font-display); font-weight: var(--fw-display);
    text-transform: uppercase; line-height: 1.1;
    font-size: clamp(20px, 2.8vw, 34px);
  }
  .col :global(ul), .col :global(ol) { margin: var(--space-3) 0 var(--space-3) 1.1rem; }
  .col :global(li) { margin-bottom: .7rem; }

  /* A section break inside a read: a short red rule, the site's own mark for
     "a beat passes". The migrated pieces carried this as a literal "· · ·"
     paragraph, which a screen reader announced as three dots. */
  .col :global(hr) {
    border: 0; width: 72px; margin: clamp(30px, 4.5vh, 56px) 0;
    border-top: var(--rule-weight) solid var(--nt-red);
  }

  /* Definition lists carry the two-sided comparisons: the term is the person,
     the description is the record. Reads as a table to a screen reader and as
     labelled paragraphs to everyone else, and it never needs to scroll. */
  .col :global(dl) { margin: var(--space-3) 0 var(--space-4); }
  .col :global(dt) {
    font-family: var(--font-display); font-weight: var(--fw-label);
    text-transform: uppercase; letter-spacing: .06em;
    font-size: var(--type-label-sm); color: var(--nt-red);
    margin-top: var(--space-3);
  }
  .col :global(dd) { margin: var(--space-1) 0 0; }

  /* Side-by-side cards, e.g. two leaders. One column on a phone. */
  .col :global(.compare) {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: clamp(18px, 3vw, 36px); margin: clamp(28px, 4vh, 52px) 0;
  }
  .col :global(.compare > article) {
    border-top: var(--border-key) solid var(--nt-red); padding-top: var(--space-3);
  }
  .col :global(.compare h3) { margin-top: 0; }
  .col :global(.compare .big) {
    font-family: var(--font-display); font-weight: var(--fw-display);
    font-size: clamp(40px, 6vw, 64px); line-height: .9; color: var(--nt-red);
    margin: var(--space-3) 0 0;
  }
  .col :global(.compare .big small) {
    display: block; font-family: var(--font-display); font-weight: var(--fw-label);
    font-size: var(--type-stamp); letter-spacing: var(--ls-caption); text-transform: uppercase;
    color: var(--text-caption); margin-top: var(--space-1);
  }
  .col :global(figcaption), .col :global(.fig) {
    font-family: var(--font-display); font-weight: var(--fw-label);
    font-size: var(--type-stamp); letter-spacing: var(--ls-caption);
    text-transform: uppercase; color: var(--text-caption);
    margin: var(--space-2) 0 var(--space-4);
  }

  /* Tables scroll inside their own box rather than widening the page. */
  .col :global(.tw) { overflow-x: auto; margin: clamp(28px, 4vh, 52px) 0; -webkit-overflow-scrolling: touch; }
  .col :global(table) { width: 100%; border-collapse: collapse; font-size: var(--type-body-sm); min-width: 34rem; }
  /* A three-column table with short cells wraps at phone width instead of
     scrolling; scrolling would hide the column that carries the point. */
  .col :global(table.narrow) { min-width: 0; }
  .col :global(caption) { text-align: left; caption-side: top; }
  .col :global(th) {
    background: var(--nt-black); color: var(--nt-white); text-align: left;
    font-family: var(--font-display); font-weight: var(--fw-label);
    font-size: var(--type-label-sm); letter-spacing: var(--ls-key); text-transform: uppercase;
    padding: 11px 13px;
  }
  .col :global(td) { border-bottom: var(--border-hair) solid var(--border-hairline); padding: 11px 13px; vertical-align: top; }
  .col :global(tbody tr:first-child td) { font-weight: var(--fw-body-strong); }
</style>
